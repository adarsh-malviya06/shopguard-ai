# ==============================================================================
# ShopGuard AI — Environment Configuration Example
# ==============================================================================

# Service Ports & Hosts
SHOPGUARD_HOST=0.0.0.0
SHOPGUARD_PORT=8010
SIMULATOR_HOST=0.0.0.0
SIMULATOR_PORT=8002
SIMULATOR_URL=http://localhost:8002
STREAMLIT_PORT=8501

# LLM Provider Configuration (Groq Free Tier)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=512

# Database & Storage Paths
SIMULATOR_DB_PATH=data/simulator.db
SHOPGUARD_DB_PATH=data/shopguard.db
CHROMA_PERSIST_DIR=data/chroma
AUDIT_LOG_PATH=logs/audit.jsonl

# Logging & Telemetry
LOG_LEVEL=INFO

# Security, Caching & Rate Limiting
RATE_LIMIT_GLOBAL_PER_MIN=60
RATE_LIMIT_PER_SESSION_PER_MIN=20
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=100
